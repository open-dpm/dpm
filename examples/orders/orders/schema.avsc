{
  "type": "record",
  "name": "Order",
  "namespace": "orders.orders",
  "doc": "Orders placed in the online store (conforms to order@1)",
  "fields": [
    {
      "name": "order_id",
      "type": "string",
      "doc": "Stable unique identifier of the order"
    },
    {
      "name": "customer_id",
      "type": "string",
      "doc": "Identifier of the customer who placed the order"
    },
    {
      "name": "total_amount",
      "type": "double",
      "doc": "Order total in the order currency"
    },
    {
      "name": "currency",
      "type": "string",
      "doc": "ISO 4217 currency code, e.g. EUR"
    },
    {
      "name": "placed_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "When the order was placed, UTC milliseconds (canonical: created_at)"
    },
    {
      "name": "status",
      "type": ["null", "string"],
      "default": null,
      "doc": "Order lifecycle status, e.g. placed/paid/shipped"
    }
  ]
}
