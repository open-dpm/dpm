{
  "type": "record",
  "name": "PosOrder",
  "namespace": "orders.pos_orders",
  "doc": "In-store point-of-sale orders (conforms to order@1)",
  "fields": [
    {
      "name": "order_id",
      "type": "string",
      "doc": "Stable unique identifier of the order"
    },
    {
      "name": "customer_id",
      "type": "string",
      "doc": "Identifier of the customer who placed the order"
    },
    {
      "name": "total_amount",
      "type": "double",
      "doc": "Order total in the order currency"
    },
    {
      "name": "currency",
      "type": "string",
      "doc": "ISO 4217 currency code, e.g. EUR"
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "When the order was placed at the till, UTC milliseconds"
    },
    {
      "name": "store_id",
      "type": "string",
      "doc": "Identifier of the physical store"
    },
    {
      "name": "status",
      "type": ["null", "string"],
      "default": null,
      "doc": "Order lifecycle status"
    }
  ]
}
