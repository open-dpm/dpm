{
  "type": "record",
  "name": "Customer",
  "namespace": "canonical.customer.v1",
  "doc": "Canonical customer (v1): mandatory attributes are the non-nullable fields",
  "fields": [
    {
      "name": "customer_id",
      "type": "string",
      "doc": "Stable unique identifier of the customer (mandatory)"
    },
    {
      "name": "email",
      "type": "string",
      "doc": "Primary email address (mandatory)"
    },
    {
      "name": "full_name",
      "type": "string",
      "doc": "Customer full name (mandatory)"
    },
    {
      "name": "created_at",
      "type": {
        "type": "long",
        "logicalType": "timestamp-millis"
      },
      "doc": "When the customer account was created, UTC milliseconds (mandatory)"
    }
  ]
}
